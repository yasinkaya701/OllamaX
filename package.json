{
  "name": "ollamax",
  "version": "2.5.0",
  "description": "OllamaX Ultra - Local AI Agent Studio",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/start-electron.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "jest",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\"",
    "rebuild-pty": "npx --yes @electron/rebuild -f -w node-pty"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "build": {
    "appId": "com.ollamax.ultra",
    "productName": "OllamaX-Ultra",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "docs/**/*.md",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    }
  },
  "keywords": [],
  "author": "Yasin Kaya",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3"
  }
}
